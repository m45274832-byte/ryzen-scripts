local function makeDraggable(button,onTap)
    button.InputBegan:Connect(function(input)
        if input.UserInputType==Enum.UserInputType.MouseButton1 or input.UserInputType==Enum.UserInputType.Touch then
            local dragStart=input.Position local startPos=button.Position
            local moved=false local moveConn
            moveConn=UserInputService.InputChanged:Connect(function(m)
                if m.UserInputType==Enum.UserInputType.MouseMovement or m.UserInputType==Enum.UserInputType.Touch then
                    local delta=m.Position-dragStart
                    if math.abs(delta.X)>6 or math.abs(delta.Y)>6 then moved=true end
                    if moved then
                        local vp=workspace.CurrentCamera.ViewportSize
                        local nx=startPos.X.Scale+(delta.X/vp.X)
                        local ny=startPos.Y.Scale+(delta.Y/vp.Y)
                        nx=math.clamp(nx,0,1-(button.Size.X.Offset/vp.X))
                        ny=math.clamp(ny,0,1-(button.Size.Y.Offset/vp.Y))
                        button.Position=UDim2.new(nx,0,ny,0)
                    end
                end
            end)
            input.Changed:Connect(function()
                if input.UserInputState==Enum.UserInputState.End then
                    if moveConn then moveConn:Disconnect() end
                    if not moved then onTap() end
                end
            end)
        end
    end)
end

local function stopFling()
    flinging=false
    if flingThread then pcall(task.cancel,flingThread) flingThread=nil end
    lfBtn.BackgroundColor3=Color3.fromRGB(30,30,40) lfBtn.Text="LF"
end
local function startFling()
    if flinging then stopFling() return end
    local ch=LocalPlayer.Character local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
    local h=ch and ch:FindFirstChildOfClass("Humanoid")
    if not hrp or not h then return end
    flinging=true lfBtn.BackgroundColor3=Color3.fromRGB(120,20,20) lfBtn.Text="STOP"
    hrp.AssemblyLinearVelocity=Vector3.new(hrp.AssemblyLinearVelocity.X,JUMP_POWER,hrp.AssemblyLinearVelocity.Z)
    h:ChangeState(Enum.HumanoidStateType.Jumping)
    flingThread=task.spawn(function()
        local t0=tick() local cam=workspace.CurrentCamera
        local baseYaw=nil local north=true
        while flinging do
            task.wait(1/FLING_SPEED)
            if not flinging then break end
            if tick()-t0>MAX_FLING_TIME then break end
            if not ch or not ch.Parent then break end
            local root=ch:FindFirstChild("HumanoidRootPart")
            local hh=ch:FindFirstChildOfClass("Humanoid")
            if not root then break end
            if hh and hh.FloorMaterial~=Enum.Material.Air then break end
            if cam then
                if not baseYaw then local _,cy,_=cam.CFrame:ToOrientation() baseYaw=math.deg(cy) end
                local ty
                if north then ty=baseYaw+FLING_ANGLE else ty=baseYaw-FLING_ANGLE end
                north=not north
                cam.CFrame=CFrame.new(cam.CFrame.Position)*CFrame.Angles(0,math.rad(ty),0)
            end
        end
        stopFling()
    end)
end
makeDraggable(lfBtn,startFling)

