local function rotateCamera(degrees,duration)
    local cam=workspace.CurrentCamera if not cam then return end
    local sc=cam.CFrame local tc=sc*CFrame.Angles(0,math.rad(degrees),0)
    local t0=os.clock()
    task.spawn(function()
        while true do
            local a=(os.clock()-t0)/duration
            if a>=1 then cam.CFrame=tc break end
            cam.CFrame=sc:Lerp(tc,a) task.wait()
        end
    end)
end
