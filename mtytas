-- ===== TRAJECTORY =====
local function clearTrajectory()
    for _,p in ipairs(trajectoryParts) do if p and p.Parent then p:Destroy() end end
    trajectoryParts={}
end
local function makeTrajSegment(from,to,tr)
    local d=to-from local len=d.Magnitude
    if len<0.001 then return end
    local p=Instance.new("Part")
    p.Size=Vector3.new(TRAJ_THICKNESS,TRAJ_THICKNESS,len)
    p.Anchored=true p.CanCollide=false p.CanQuery=false p.CanTouch=false
    p.Material=Enum.Material.Neon p.Color=TRAJ_COLOR p.Transparency=tr
    p.CFrame=CFrame.new(from+d*0.5,to) p.Parent=workspace
    table.insert(trajectoryParts,p)
end
local function makeTrajDot(pos,size)
    local d=Instance.new("Part")
    d.Shape=Enum.PartType.Ball d.Size=Vector3.new(size,size,size)
    d.Anchored=true d.CanCollide=false d.CanQuery=false d.CanTouch=false
    d.Material=Enum.Material.Neon d.Color=TRAJ_COLOR d.Transparency=0.05
    d.CFrame=CFrame.new(pos) d.Parent=workspace
    table.insert(trajectoryParts,d)
end
local function renderGroundLine(ch,hrp,h)
    local md=h.MoveDirection
    if md.Magnitude<0.05 then md=hrp.CFrame.LookVector end
    local dir=Vector3.new(md.X,0,md.Z)
    if dir.Magnitude<0.001 then return end
    dir=dir.Unit
    local origin=hrp.Position
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={ch}
    local steps=math.floor(GROUND_LENGTH/GROUND_STEP)
    local prev=origin local lastValid=nil local segs={}
    for i=1,steps do
        local np=origin+dir*(i*GROUND_STEP)
        local down=workspace:Raycast(np+Vector3.new(0,5,0),Vector3.new(0,-20,0),params)
        if down then
            np=down.Position+Vector3.new(0,GROUND_HEIGHT_OFFSET,0)
            local rtn=np-prev
            local wall=workspace:Raycast(prev+Vector3.new(0,GROUND_HEIGHT_OFFSET,0),rtn,params)
            if wall then break end
            if lastValid then
                local dy=math.abs(np.Y-lastValid.Y)
                if dy>3 then break end
            end
            table.insert(segs,{from=prev,to=np})
            prev=np lastValid=np
        else break end
    end
    local total=#segs
    for i,seg in ipairs(segs) do makeTrajSegment(seg.from,seg.to,0.1+(i/total)*0.65) end
    if lastValid then makeTrajDot(lastValid,TRAJ_THICKNESS*2.5) end
end
local function renderAirParabola(ch,hrp)
    local pos=hrp.Position local vel=hrp.AssemblyLinearVelocity local g=workspace.Gravity
    local prev=pos local t=0 local hitG=false local gp=nil
    local params=RaycastParams.new()
    params.FilterType=Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances={ch}
    for i=1,AIR_STEPS do
        local t1=t+AIR_STEP_TIME
        local x=pos.X+vel.X*t1
        local y=pos.Y+vel.Y*t1-0.5*g*t1*t1
        local z=pos.Z+vel.Z*t1
        local cur=Vector3.new(x,y,z)
        local seg=cur-prev local len=seg.Magnitude
        if len>0.001 then
            local r=workspace:Raycast(prev,seg,params)
            if r then cur=r.Position gp=cur hitG=true seg=cur-prev len=seg.Magnitude end
        end
        if len>0.001 then makeTrajSegment(prev,cur,0.1+(i/AIR_STEPS)*0.6) end
        if i%10==0 and not hitG then makeTrajDot(cur,TRAJ_THICKNESS*2.2) end
        prev=cur t=t1
        if hitG then break end
        if cur.Y<pos.Y-1000 then break end
    end
    if gp then
        local m=Instance.new("Part")
        m.Shape=Enum.PartType.Cylinder m.Size=Vector3.new(0.05,2.2,2.2)
        m.Anchored=true m.CanCollide=false m.CanQuery=false m.CanTouch=false
        m.Material=Enum.Material.Neon m.Color=TRAJ_COLOR m.Transparency=0.4
        m.CFrame=CFrame.new(gp+Vector3.new(0,0.05,0))*CFrame.Angles(0,0,math.rad(90))
        m.Parent=workspace table.insert(trajectoryParts,m)
    end
end
local function renderTrajectory()
    if not TRAJECTORY_ENABLED then clearTrajectory() return end
    local ch=LocalPlayer.Character
    local hrp=ch and ch:FindFirstChild("HumanoidRootPart")
    local h=ch and ch:FindFirstChildOfClass("Humanoid")
    if not (hrp and h) then return end
    clearTrajectory()
    local gr=h.FloorMaterial~=Enum.Material.Air
    if gr then renderGroundLine(ch,hrp,h) else renderAirParabola(ch,hrp) end
end

